{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobyst-global",
  // The Cloudflare account that owns nobyst.com. Pinned so a deploy can never land in another
  // account wrangler happens to be signed in to.
  "account_id": "068c53ba5374963a4ab2b68a8df626ff",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nobyst-catalog",
      // Replace with the id printed by: npx wrangler d1 create nobyst-catalog
      "database_id": "305821fd-2277-4542-8294-ca8d5d9c9510"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nobyst-media"
    }
  ],
  "vars": {
    "EMAIL_FROM": "NOBYST GLOBAL <info@nobyst.com>",
    "SITE_URL": "https://nobyst.com",
    // Cloudflare Turnstile public site key (safe to publish). The matching secret is the
    // TURNSTILE_SECRET_KEY worker secret; the bot check is on only when both are set.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGQG4hXkPiGERRDk"
  },
  "observability": {
    "enabled": true
  }
}
